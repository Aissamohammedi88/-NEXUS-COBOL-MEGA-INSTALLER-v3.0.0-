detect_os() {
if [ -f /etc/os-release ]; then
. /etc/os-release
OS_ID="${ID:-unknown}"
OS_NAME="${PRETTY_NAME:-$OS_ID}"
OS_FAMILY="${ID_LIKE:-$OS_ID}"
elif [ "$(uname -s)" = "Darwin" ]; then
OS_ID="macos"
OS_NAME="macOS $(sw_vers -productVersion 2>/dev/null || echo '')"
OS_FAMILY="macos"
else
OS_ID="unknown"
OS_NAME="$(uname -s)"
OS_FAMILY="unknown"
fi

case "$OS_FAMILY" in
*debian*|*ubuntu*) PKG_MGR="apt";;
*fedora*|*rhel*) PKG_MGR="dnf";;
*arch*) PKG_MGR="pacman";;
*macos*) PKG_MGR="brew";;
*) PKG_MGR="unknown";;
esac
}

