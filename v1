# ETAPE 5 : COMPILATION
# ═══════════════════════════════════════════════════════════════════════════════

NB_OK=0
NB_KO=0
TOTAL_TIME=0
TOTAL_SIZE=0

compile_all() {
section "ETAPE 5 / 9 · COMPILATION COBOL"

info "Niveau d'optimisation : -$OPT_OPT_LEVEL"
[ "$OPT_STRIP" = "1" ] && info "Strip des binaires : activé"
[ "$OPT_UPX" = "1" ] && info "Compression UPX : activée"
echo ""

cd "$SRC_DIR" || exit 1

local rapport_run="${REPORT_DIR}/run_${BUILD_ID}.txt"
{
echo "═══════════════════════════════════════════════════════════════════"
echo "NEXUS COBOL ENTERPRISE - RUN REPORT"
echo "═══════════════════════════════════════════════════════════════════"
echo "Date : $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "Build ID : $BUILD_ID"
echo "cobc : $(cobc --version | head -1)"
echo "Flags : -$OPT_OPT_LEVEL"
echo "═══════════════════════════════════════════════════════════════════"
echo ""
} > "$rapport_run"

for src in *.cob; do
[ -f "$src" ] || continue
local nom="${src%.cob}"
local bin="${BIN_DIR}/${nom}"

printf " ${BOLD}${MAGENTA}▸${RESET} ${BOLD}%s${RESET}\n" "$src"

# Compilation chronométrée
local t0 t1 compile_ms
t0=$(date +%s%N)
if cobc -x -free "-${OPT_OPT_LEVEL}" -o "$bin" "$src" 2>"${CACHE_DIR}/${nom}.cerr"; then
t1=$(date +%s%N)
compile_ms=$(( (t1 - t0) / 1000000 ))
local taille
taille=$(stat -c%s "$bin" 2>/dev/null || echo 0)
ok "Compile ${DIM}(${taille} o · ${compile_ms} ms)${RESET}"

# Exécution
cd "$RUN_DIR" || exit 1
local t2 t3 run_ms
t2=$(date +%s%N)
if timeout 60 "$bin" > "${CACHE_DIR}/${nom}.out" 2>"${CACHE_DIR}/${nom}.rerr"; then
t3=$(date +%s%N)
run_ms=$(( (t3 - t2) / 1000000 ))
ok "Execute ${DIM}(${run_ms} ms)${RESET}"

# Afficher la sortie (indentée)
if [ -s "${CACHE_DIR}/${nom}.out" ]; then
echo -e " ${DIM}┌─────────────────────────────────────────${RESET}"
while IFS= read -r line; do
printf " ${DIM}│${RESET} %s\n" "$line"
done < "${CACHE_DIR}/${nom}.out"
echo -e " ${DIM}└─────────────────────────────────────────${RESET}"
fi

NB_OK=$((NB_OK + 1))
TOTAL_TIME=$((TOTAL_TIME + run_ms))
TOTAL_SIZE=$((TOTAL_SIZE + taille))

{
echo "─── $nom : SUCCES ───"
echo "Compile : $compile_ms ms"
echo "Run : $run_ms ms"
echo "Taille : $taille octets"
echo ""
cat "${CACHE_DIR}/${nom}.out"
echo ""
} >> "$rapport_run"
else
err "Échec d'exécution"
[ -s "${CACHE_DIR}/${nom}.rerr" ] && head -5 "${CACHE_DIR}/${nom}.rerr" | sed 's/^/ /'
NB_KO=$((NB_KO + 1))
echo "─── $nom : ECHEC EXECUTION ───" >> "$rapport_run"
fi
cd "$SRC_DIR" || exit 1
else
err "Échec de compilation"
[ -s "${CACHE_DIR}/${nom}.cerr" ] && head -5 "${CACHE_DIR}/${nom}.cerr" | sed 's/^/ /'
NB_KO=$((NB_KO + 1))
echo "─── $nom : ECHEC COMPILATION ───" >> "$rapport_run"
fi

# Optimisation post-compilation
if [ -f "$bin" ] && [ "$OPT_STRIP" = "1" ]; then
local avant apres
avant=$(stat -c%s "$bin" 2>/dev/null || echo 0)
cp "$bin" "${OPT_DIR}/${nom}.orig" 2>/dev/null || true
strip "$bin" 2>/dev/null && {
apres=$(stat -c%s "$bin" 2>/dev/null || echo 0)
local gain=$((avant - apres))
if [ "$gain" -gt 0 ]; then
printf " ${DIM}strip : %d → %d o (-%d o)${RESET}\n" "$avant" "$apres" "$gain"
fi
} || true
fi

echo ""
done

log_info "Compilation terminée : $NB_OK OK, $NB_KO KO"
}

