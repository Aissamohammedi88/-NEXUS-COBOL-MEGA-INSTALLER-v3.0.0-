log() {
local level="$1"
shift
local msg="$*"
local ts
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf "[%s] [%s] %s\n" "$ts" "$level" "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

